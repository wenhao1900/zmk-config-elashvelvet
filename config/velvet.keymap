#define BASE 0
#define LOWER 1
#define MOUSE_KEYS 2
#define MOUSE_TP 3
#define MOUSE_TP_SET 4
#define SCROLL 4

#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors/toggle_io.dtsi>
#include <behaviors/on_io.dtsi>
#include <behaviors/off_io.dtsi>
#include <input/processors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener {
    input-processors = <&zip_xy_scaler 1 1>;

    scroll_mode {
        layers = <SCROLL>;
        input-processors = <&zip_xy_to_scroll_mapper>, <&zip_scroll_scaler 1 1>;
    };
};

&msc_input_listener { input-processors = <&zip_scroll_scaler 1 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <200>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <20>;
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };
    };

    combos {
        compatible = "zmk,combos";

        rt {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <4 5>;
        };

        yu {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
        };

        vb {
            bindings = <&kp LS(APOSTROPHE)>;
            key-positions = <30 31>;
        };

        nm {
            bindings = <&kp APOSTROPHE>;
            key-positions = <33 34>;
        };

        qw {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
&mkp LCLK  &kp Q             &kp W               &kp E           &kp R            &kp T               &kp C_VOL_UP       &kp Y        &kp U      &kp I            &kp O                &kp P                      &mkp LCLK
&mkp RCLK  &hm LEFT_SHIFT A  &hm LEFT_CONTROL S  &hm LEFT_ALT D  &hm LEFT_GUI F   &kp G               &kp K_MUTE         &kp H        &kp J      &hm RIGHT_ALT K  &hm RIGHT_CONTROL L  &hm RIGHT_SHIFT SEMICOLON  &mkp RCLK
&tog 4     &kp Z             &kp X               &kp C           &kp V            &kp B               &kp C_VOLUME_DOWN  &kp N        &kp M      &kp COMMA        &kp DOT              &kp FSLH                   &kp ESC
           &mmv MOVE_UP      &mmv MOVE_DOWN      &kp TAB         &lt 2 BACKSPACE  &mt LEFT_GUI SPACE                     &lt 1 COMMA  &kp ENTER  &kp CAPS         &kp LEFT_ARROW       &kp RIGHT
            >;

            label = "BASE";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_1 {
            bindings = <
&trans  &kp GRAVE          &kp UP_ARROW              &kp N3              &kp N4          &kp N9        &trans      &kp NUMBER_3  &kp NUMBER_6  &kp RIGHT_ALT  &kp RIGHT_CONTROL  &kp ESC   &trans
&trans  &kp LEFT_ARROW     &kp DOWN_ARROW            &kp RIGHT_ARROW     &kp NUMBER_0    &kp NUMBER_8  &kp K_MUTE  &kp NUMBER_2  &kp N5        &kp MINUS      &kp EQUAL          &kp SQT   &trans
&trans  &kp C_VOLUME_DOWN  &kp K_MUTE                &kp C_VOLUME_UP     &trans          &kp N7        &trans      &kp NUMBER_1  &kp NUMBER_4  &kp LBKT       &kp RBKT           &kp CAPS  &trans
        &trans             &mt LEFT_SHIFT BACKSPACE  &mt LEFT_GUI SPACE  &kp LEFT_SHIFT  &kp SPACE                 &lt 1 COMMA   &kp TAB       &kp TAB        &kp ENTER          &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &to 3           &trans    &mkp MB4   &kp LA(Q)     &kp LA(A)  &trans  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans        &trans  &trans
&trans  &kp LEFT_SHIFT  &trans    &kp ENTER  &trans        &trans     &trans  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans        &trans  &trans
&trans  &trans          &trans    &none      &none         &trans     &trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans        &trans  &trans
        &trans          &kp LGUI  &kp SPACE  &kp NUMBER_0  &kp SPACE          &kp RET       &kp TAB       &kp N0        &kp NUMBER_0  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &to 0           &kp W            &mkp MB4            &tog 4           &mkp MB1            &trans  &msc SCRL_LEFT  &msc SCRL_DOWN    &msc SCRL_UP   &msc SCRL_RIGHT  &to 0   &trans
&trans  &kp A           &kp S            &kp ENTER           &tog 4           &mkp MB2            &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN    &mmv MOVE_UP   &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp LEFT_ARROW  &kp RIGHT_ARROW  &kp C               &kp V            &mkp MB1            &trans  &kp LG(EQUAL)   &kp LG(NUMBER_0)  &kp LG(MINUS)  &sys_reset       &trans  &trans
        &trans          &kp LGUI         &mt LEFT_GUI SPACE  &lt 4 BACKSPACE  &mt LEFT_GUI SPACE          &kp RET         &kp TAB           &mkp MB1       &lt 2 ENTER      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_4 {
            bindings = <
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &tog 4  &kp LA(A)  &trans  &trans   &trans   &trans     &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans     &trans  &trans   &trans   &trans     &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans  &trans     &trans  &trans   &trans   &trans     &trans  &trans  &trans
        &trans        &kp LGUI      &trans        &trans  &kp SPACE          &kp RET  &kp TAB  &kp SPACE  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
        &trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
